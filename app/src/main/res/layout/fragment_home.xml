<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    tools:context=".HomeFragment">

    <!-- ═══════════════════  TOP BAR  ═══════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pv_ink_wordmark"
            android:textAppearance="@style/TextAppearance.PanelVerse.Display"
            android:textSize="30sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHomeOffline"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingHorizontal="8dp"
            android:text="@string/pv_offline_short"
            android:textAllCaps="false"
            style="@style/Widget.PanelVerse.Button.Outlined" />

    </LinearLayout>

    <!-- ═══════════════════  SEARCH  ═══════════════════ -->
    <EditText
        android:id="@+id/mangaSearchEditText"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="@dimen/screen_padding_h"
        android:layout_marginEnd="@dimen/screen_padding_h"
        android:background="@drawable/bg_ink_search"
        android:hint="@string/pv_search_manga_comics"
        android:textColorHint="#5F5A52"
        android:textColor="#121212"
        android:textSize="14sp"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:inputType="text"
        android:importantForAutofill="no"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:singleLine="true" />

    <include layout="@layout/view_ink_feature" />

    <!-- ═══════════════════  CATEGORY CHIPS  ═══════════════════ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xs"
        android:fadingEdgeLength="20dp"
        android:requiresFadingEdge="horizontal">

        <LinearLayout
            android:id="@+id/categoryChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding_h"
            android:paddingEnd="@dimen/screen_padding_h"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- ═══════════════════  SECTION HEADING  ═══════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/sectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.PanelVerse.Caption" />

        <View
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:layout_weight="2"
            android:background="@drawable/bg_ink_screentone"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- ═══════════════════  LIST + OVERLAYS  ═══════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mangaRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="68dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_manga_card_grid" />

        <LinearLayout
            android:id="@+id/emptyStateView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_ink_panel"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/pv_no_titles_found"
                android:textAppearance="@style/TextAppearance.PanelVerse.Title"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/pv_try_another_search_or_category"
                android:textAppearance="@style/TextAppearance.PanelVerse.Caption" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabRandom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="18dp"
            android:contentDescription="@string/pv_open_a_random_title"
            app:srcCompat="@drawable/ic_dice"
            app:backgroundTint="@color/bg_card"
            app:tint="@color/text_primary"
            app:fabCustomSize="48dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabBackToTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="74dp"
            android:visibility="gone"
            android:contentDescription="@string/pv_back_to_top"
            app:srcCompat="@drawable/ic_arrow_up"
            app:backgroundTint="@color/bg_elevated"
            app:tint="@color/text_primary"
            app:fabCustomSize="48dp" />

    </FrameLayout>

</LinearLayout>
