<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    tools:context=".HomeFragment">

    <!-- ═══════════════════  MANGA MASTHEAD HEADER  ═══════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_header"
        android:paddingTop="40dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Top row: branding left · saved button right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Red ink spine + title block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Thick red ink bar — like a manga title page spine -->
                <View
                    android:layout_width="5dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_ink_bar"/>

                <!-- App name stacked -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PANEL"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:lineSpacingMultiplier="0.9"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VERSE"
                            android:textColor="@color/accent_ink"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02"
                            android:lineSpacingMultiplier="0.9"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="漫画"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ❤️ Saved pill -->
            <TextView
                android:id="@+id/btnViewFavorites"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="❤  SAVED"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/bg_ink_bar"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Thin red ink underline under masthead -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:background="@color/accent_ink"
            android:alpha="0.4"/>

        <!-- Search bar -->
        <EditText
            android:id="@+id/mangaSearchEditText"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:hint="🔍  Search titles…"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:singleLine="true"/>

    </LinearLayout>

    <!-- ═══════════════════  CATEGORY CHIPS  ═══════════════════ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/bg_dark"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:fadingEdgeLength="20dp"
        android:requiresFadingEdge="horizontal">

        <LinearLayout
            android:id="@+id/categoryChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"/>

    </HorizontalScrollView>

    <!-- ══════════════════  SECTION HEADING  ══════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <!-- Red ink bar accent -->
        <View
            android:layout_width="4dp"
            android:layout_height="16dp"
            android:background="@color/accent_ink"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="ALL TITLES"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

    </LinearLayout>

    <!-- ══════════════════════  LIST  ══════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mangaRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="90dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_manga_card"/>

</LinearLayout>
