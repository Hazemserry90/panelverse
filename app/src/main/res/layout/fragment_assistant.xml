<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    tools:context=".AssistantFragment">

    <!-- ═══════════════════  COMPACT HEADER  ═══════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="38dp"
        android:paddingBottom="10dp"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/pv_assistant"
            android:textAppearance="@style/TextAppearance.PanelVerse.Display"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/assistantSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/pv_tell_me_what_you_re_in_the_mood_for_and_i_ll"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- ═══════════════════  INPUT + SUGGEST (one row)  ═══════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_h"
        android:layout_marginEnd="@dimen/screen_padding_h"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/interestInput"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="@string/pv_e_g_dark_superhero_stories"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:inputType="text"
            android:importantForAutofill="no"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:singleLine="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSuggest"
            style="@style/Widget.PanelVerse.Button"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/pv_suggest" />
    </LinearLayout>

    <!-- secondary, compact link -->
    <TextView
        android:id="@+id/btnFromHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/pv_from_my_reading_history"
        android:textColor="@color/accent_cyan"
        android:textSize="12sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />

    <!-- ═══════════════════  INTERESTS (compact)  ═══════════════════ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="6dp"
        android:text="@string/pv_pick_your_interests"
        android:textAppearance="@style/TextAppearance.PanelVerse.Section" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingBottom="6dp"
        android:fadingEdgeLength="20dp"
        android:requiresFadingEdge="horizontal">

        <LinearLayout
            android:id="@+id/interestChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding_h"
            android:paddingEnd="@dimen/screen_padding_h"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- ═══════════════════  MESSAGE (compact)  ═══════════════════ -->
    <TextView
        android:id="@+id/assistantMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_h"
        android:layout_marginEnd="@dimen/screen_padding_h"
        android:layout_marginBottom="8dp"
        android:padding="10dp"
        android:background="@drawable/bg_section_card"
        android:text="@string/pv_hi_pick_some_interests_or_type_what_you_re_in"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.2" />

    <!-- ═══════════════════  RESULTS  ═══════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestionRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_manga_card" />

</LinearLayout>
