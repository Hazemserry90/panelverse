<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingBottom="48dp">

        <!-- "Create Account" title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="Create Account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <!-- Sparkles emoji -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="✨"
            android:textSize="40sp"
            android:gravity="center"
            android:includeFontPadding="false" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Join MangaVerse today"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

        <!-- Username field -->
        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_input_field"
            android:hint="Username"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:inputType="text"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:drawableStart="@drawable/baseline_account_circle_24"
            android:drawablePadding="12dp"
            android:drawableTint="@color/text_muted"
            android:singleLine="true" />

        <!-- Email field -->
        <EditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="Email address"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:inputType="textEmailAddress"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:drawableStart="@drawable/baseline_email_24"
            android:drawablePadding="12dp"
            android:drawableTint="@color/text_muted"
            android:singleLine="true" />

        <!-- Password field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/text_muted"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:hint="Password"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:paddingStart="18dp"
                android:paddingEnd="52dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:drawableStart="@drawable/baseline_key_24"
                android:drawablePadding="12dp"
                android:drawableTint="@color/text_muted" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm Password field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirmPasswordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/text_muted"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirmPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:hint="Confirm Password"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:paddingStart="18dp"
                android:paddingEnd="52dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:drawableStart="@drawable/baseline_key_24"
                android:drawablePadding="12dp"
                android:drawableTint="@color/text_muted" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- SIGN UP button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/signupbtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:text="SIGN UP"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.06"
            app:backgroundTint="@color/accent_purple"
            app:cornerRadius="16dp"
            app:elevation="0dp" />

        <!-- Already have an account (decorative) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Already have an account? Login"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>
