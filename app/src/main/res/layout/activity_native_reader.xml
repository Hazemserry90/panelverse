<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/nativePages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never" />

    <LinearLayout
        android:id="@+id/nativeTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121212"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/nativeClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pv_back" />

        <TextView
            android:id="@+id/nativeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textColor="#F1ECE1" />

        <Button
            android:id="@+id/nativeOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pv_ink_reader_options" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nativeError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/nativeMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#F1ECE1" />

        <Button
            android:id="@+id/nativeRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pv_chapter_retry"
            android:visibility="gone" />

        <Button
            android:id="@+id/nativeWeb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pv_chapter_web"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nativeBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#121212"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:id="@+id/nativeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/nativePrevious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pv_page_previous" />

            <SeekBar
                android:id="@+id/nativeSeek"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/pv_page_jump"
                android:progressTint="#D8392B"
                android:thumbTint="#D8392B" />

            <Button
                android:id="@+id/nativeNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pv_page_next" />
        </LinearLayout>

        <TextView
            android:id="@+id/nativeCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textColor="#F1ECE1" />

        <ProgressBar
            android:id="@+id/nativeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:progressTint="#D8392B" />
    </LinearLayout>
</FrameLayout>
