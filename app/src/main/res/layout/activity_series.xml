<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/seriesClose"
            style="@style/Widget.PanelVerse.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pv_back" />

        <ImageView
            android:id="@+id/seriesCover"
            android:layout_width="match_parent"
            android:layout_height="256dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ink_panel"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/seriesCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_ink_caption"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:textColor="#121212"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seriesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.PanelVerse.Display" />

        <TextView
            android:id="@+id/seriesProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.PanelVerse.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/seriesRead"
            style="@style/Widget.PanelVerse.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pv_ink_start" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/seriesSave"
                style="@style/Widget.PanelVerse.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pv_library_favorite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/seriesShare"
                style="@style/Widget.PanelVerse.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/pv_ink_share" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/seriesWant"
            style="@style/Widget.PanelVerse.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pv_saved_want" />

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_ink_screentone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/seriesChaptersStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pv_chapter_loading"
            android:textAppearance="@style/TextAppearance.PanelVerse.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/seriesChaptersRetry"
            style="@style/Widget.PanelVerse.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pv_chapter_retry"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/seriesChaptersWeb"
            style="@style/Widget.PanelVerse.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pv_chapter_web" />

        <LinearLayout
            android:id="@+id/seriesChapters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/seriesChaptersMore"
            style="@style/Widget.PanelVerse.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pv_chapter_more"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
