<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Diagonal red glow — top left corner, like action panel lighting -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-100dp"
        android:background="@drawable/bg_avatar_circle"
        android:alpha="0.06"/>

    <!-- Bottom right glow -->
    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="-80dp"
        android:layout_marginEnd="-80dp"
        android:background="@drawable/bg_avatar_circle"
        android:alpha="0.04"/>

    <!-- Main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="80dp"
            android:paddingBottom="48dp">

            <!-- Big ink panel title block -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Left red ink bar -->
                <View
                    android:layout_width="6dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_ink_bar"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MANGA"
                        android:textColor="@color/text_primary"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:lineSpacingMultiplier="0.85"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VERSE"
                        android:textColor="@color/accent_ink"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:lineSpacingMultiplier="0.85"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Japanese subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="漫画 · COMICS · UNIVERSE"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.20"
                android:gravity="center"/>

            <!-- Red ink rule -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:background="@color/accent_ink"
                android:alpha="0.5"/>

            <!-- Genre tags row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="22dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MANGA"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_tag_manga"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="MARVEL"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_tag_marvel"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="DC"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_tag_dc"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="MORE"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_tag_invincible"/>
            </LinearLayout>

            <!-- LOGIN button — bold ink style -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/startgame"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="36dp"
                android:text="LOGIN"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:letterSpacing="0.14"
                app:backgroundTint="@color/accent_ink"
                app:cornerRadius="6dp"
                app:elevation="4dp"/>

            <!-- CREATE ACCOUNT button — outlined -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/register"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="CREATE ACCOUNT"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="0.08"
                app:backgroundTint="@color/bg_card"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="6dp"/>

            <!-- Footer text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="30+ titles · Manga, Marvel, DC &amp; more"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.04"
                android:gravity="center"/>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
