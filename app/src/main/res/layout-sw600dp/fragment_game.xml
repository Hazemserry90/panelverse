<?xml version="1.0" encoding="utf-8"?>
<!-- Tablet / foldable: centre the auth content in a comfortable column -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    tools:context=".LoginFragment">

    <LinearLayout
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/screen_padding_auth_h"
        android:paddingEnd="@dimen/screen_padding_auth_h"
        android:paddingTop="80dp"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:text="@string/pv_4"
            android:textSize="40sp"
            android:gravity="center"
            android:background="@drawable/bg_featured_card" />

        <TextView
            android:id="@+id/login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/pv_welcome_back"
            android:textAppearance="@style/TextAppearance.PanelVerse.Display"
            android:textSize="30sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_xl"
            android:text="@string/pv_sign_in_to_your_panelverse_account"
            android:textAppearance="@style/TextAppearance.PanelVerse.Body"
            android:gravity="center" />

        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_input_field"
            android:hint="@string/pv_email_address"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:drawableStart="@drawable/baseline_account_circle_24"
            android:drawableTint="@color/text_muted"
            android:drawablePadding="14dp"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:singleLine="true" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_input_field"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/accent_ink"
            app:boxBackgroundMode="none">

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/pv_password"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:drawableStart="@drawable/baseline_key_24"
                android:drawableTint="@color/text_muted"
                android:drawablePadding="14dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/attemptsWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lockoutMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/accent_red"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ingame"
            style="@style/Widget.PanelVerse.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="28dp"
            android:text="@string/pv_login"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:letterSpacing="0.08"
            app:backgroundTint="@color/accent_ink"
            app:cornerRadius="@dimen/radius_md" />

        <TextView
            android:id="@+id/Forgetpassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/pv_forgot_password"
            android:textColor="@color/accent_ink"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/space_xs" />

    </LinearLayout>
</ScrollView>
