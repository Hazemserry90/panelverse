<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark palette resolves from values-night/colors.xml; styles mirror values. -->
    <style name="Base.Theme.Testing" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_ink</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bottom_nav_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Testing" parent="Base.Theme.Testing" />

    <style name="TextAppearance.PanelVerse.Display" parent="">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.PanelVerse.Title" parent="">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PanelVerse.Section" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PanelVerse.Subtitle" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.PanelVerse.Body" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.PanelVerse.Caption" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.PanelVerse.Label" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.PanelVerse.Button" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Widget.PanelVerse.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.PanelVerse.Button</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/accent_ink</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="rippleColor">@color/white</item>
    </style>

    <style name="Widget.PanelVerse.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.PanelVerse.Button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/bg_card</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>
</resources>
