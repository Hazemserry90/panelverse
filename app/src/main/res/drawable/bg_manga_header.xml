<?xml version="1.0" encoding="utf-8"?>
<!-- Manga masthead header: deep dark gradient with subtle top glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient — deep black to dark navy -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF0A0A12"
                android:centerColor="#FF0E0E1C"
                android:endColor="#FF050508"
                android:angle="270"/>
        </shape>
    </item>
    <!-- Top red ink accent strip -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="0dp" android:color="#00000000"/>
        </shape>
    </item>
    <!-- Left red side glow -->
    <item android:right="320dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#33FF1F3A"
                android:endColor="#00FF1F3A"
                android:angle="0"/>
        </shape>
    </item>
</layer-list>
