<?xml version="1.0" encoding="utf-8"?>
<!-- Editorial header: surface→background gradient, ink glow + halftone texture -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/bg_section"
                android:endColor="@color/bg_dark"
                android:angle="270" />
        </shape>
    </item>
    <item android:right="300dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#337C5CFF"
                android:endColor="#007C5CFF"
                android:angle="0" />
        </shape>
    </item>
    <item android:alpha="0.35" android:drawable="@drawable/bg_halftone" />
</layer-list>
