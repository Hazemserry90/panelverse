<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_heart_outline.xml
    Outlined (stroke-only) heart icon in text_muted colour.
    Canvas: 24 × 24 dp  |  ViewBox: 0 0 24 24

    Implementation note:
    Android Vector does not support strokeWidth on <path> with fillColor=none
    in the same way SVG does, so we use a stroked path with fillColor="@android:color/transparent"
    and strokeColor pointing to the text_muted colour token.
    strokeWidth="1.8dp" gives a clean, visible outline at all densities.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/text_muted"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="
            M12,21.35
            L10.55,20.03
            C5.4,15.36 2,12.27 2,8.5
            C2,5.41 4.42,3 7.5,3
            C9.24,3 10.91,3.81 12,5.08
            C13.09,3.81 14.76,3 16.5,3
            C19.58,3 22,5.41 22,8.5
            C22,12.27 18.6,15.36 13.45,20.03
            L12,21.35
            Z" />

</vector>
