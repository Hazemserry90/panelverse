<?xml version="1.0" encoding="utf-8"?>
<!-- Text input: subtle surface, ink accent stroke when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_section" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="1.5dp" android:color="@color/accent_ink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_section" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="1dp" android:color="@color/card_border" />
        </shape>
    </item>
</selector>
