<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_input_field.xml
    Text input / EditText background:
      • bg_section fill  (adapts light/dark via color resource)
      • 14dp corner radius
      • 1dp stroke using card_border color
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/bg_section" />

    <corners android:radius="14dp" />

    <stroke
        android:width="1dp"
        android:color="@color/card_border" />

</shape>
